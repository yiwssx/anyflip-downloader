# Copy to .env and replace with a randomly generated secret.
# openssl rand -hex 32
ANYFLIP_WEB_TOKEN=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS

# Optional real account authentication. Disabled until HTTPS/proxy setup is approved.
# Generate a password hash offline using: ./anyflip-downloader -hash-password < /secure/input
# No plaintext password may be committed, stored in .env, or sent in a URL.
ANYFLIP_AUTH_MODE=token
ANYFLIP_AUTH_BOOTSTRAP_USERNAME=
ANYFLIP_AUTH_BOOTSTRAP_HASH=
ANYFLIP_AUTH_COOKIE_SECURE=false
