# Token-only mode remains the default until HTTPS and Google OAuth are configured.
ANYFLIP_WEB_TOKEN=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
ANYFLIP_AUTH_MODE=token

# For Google Workspace sign-in set ANYFLIP_AUTH_MODE=google.
# Google Cloud Console → OAuth client (Web application) redirect must EXACTLY match.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR_HOSTNAME/auth/google/callback
