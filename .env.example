# Existing installations default to token mode until the operator chooses a cutover.
# This token is required ONLY in token mode; remove it after switching to Google.
ANYFLIP_WEB_TOKEN=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
ANYFLIP_AUTH_MODE=token

# Google Cloud Console > Google Auth Platform > OAuth client (Web application).
# In Google mode, the shared AnyFlip bearer token is NOT required or accepted.
# Set ANYFLIP_AUTH_MODE=google only after all three fields are populated privately.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://anyflip.rcat.ac.th/auth/google/callback
