# Staging image assembled ONLY from a verified signed linux-amd64 Web/CLI
# executable. Prepare the context with scripts/prepare-signed-web-staging.sh.
# This recipe alone does not authenticate artifacts, run a service or deploy.
FROM alpine:3.22
RUN apk add --no-cache ca-certificates \
    && addgroup -S -g 10001 anyflip \
    && adduser -S -D -H -u 10001 -G anyflip anyflip \
    && mkdir -p /data/jobs \
    && chown -R 10001:10001 /data
COPY --chown=10001:10001 anyflip-downloader /usr/local/bin/anyflip-downloader
RUN chmod 0555 /usr/local/bin/anyflip-downloader
USER 10001:10001
WORKDIR /data
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/anyflip-downloader"]
CMD ["-web", "-listen", "0.0.0.0:8080"]
